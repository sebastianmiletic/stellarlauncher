+fn star_seed(cell: vec2<f32>) -> f32 {
+    return fract(sin(dot(cell, vec2(127.1, 311.7))) * 43758.5453);
+}
+fn stars(uv: vec2<f32>, orbit: f32) -> f32 {
+    let grid = uv * vec2(126.0, 75.0);
+    let cell = floor(grid);
+    let seed = star_seed(cell);
+    let point = vec2(star_seed(cell + 6.1), star_seed(cell + 31.7));
+    let distance = length(fract(grid) - (point * 0.7 + 0.15));
+    let halo = 1.0 - smoothstep(0.035, 0.165, distance);
+    let scintillation = 0.55 + 0.45 * sin(orbit * floor(5.0 + seed * 7.0) + seed * 83.0);
+    return halo * scintillation * step(0.987, seed);
+}
+fn animate_stellar(base: vec3<f32>, screen: vec2<f32>, orbit: f32) -> vec3<f32> {
+    // The cube and shadow stay fixed. Move the filaments in the projected
+    // accretion plane and in the lensed arc above the black hole.
+    let disk = (screen - vec2(0.5, 0.58)) * vec2(1.0, 3.8);
+    let radius = length(disk);
+    let angle = atan2(disk.y, disk.x);
+    let lit = smoothstep(0.03, 0.31, base.r);
+    let band = smoothstep(0.08, 0.21, radius) * (1.0 - smoothstep(0.62, 0.91, radius));
+    let fine = sin(12.0 * (angle - orbit) + radius * 52.0);
+    let broad = sin(5.0 * (angle - orbit) - radius * 31.0);
+    let arc = (screen - vec2(0.5, 0.55)) * vec2(1.0, 0.95);
+    let arc_radius = length(arc);
+    let arc_mask = smoothstep(0.075, 0.14, arc_radius)
+        * (1.0 - smoothstep(0.24, 0.31, arc_radius))
+        * (1.0 - smoothstep(-0.025, 0.015, arc.y));
+    let lensed = sin(7.0 * (atan2(arc.y, arc.x) - orbit) + arc_radius * 53.0);
+    let gain = 1.0 + lit * (band * (0.2 * fine + 0.13 * broad) + 0.24 * arc_mask * lensed);
+    let sky = smoothstep(0.22, 0.31, length((screen - vec2(0.5, 0.5)) * vec2(1.0, 1.24)))
+        * (1.0 - smoothstep(0.025, 0.12, base.r));
+    return base * gain + vec3(0.48 * sky * stars(screen, orbit));
+}
